[
  {
    "id": "baseline-content-clipping",
    "type": "no-clip",
    "selector": "main p, main td, main th, main label, main button, main [data-viewrule=label]",
    "optional": true,
    "severity": "warning",
    "reason": "Inspect clipped content and preserve essential labels; intentional previews can use a scoped exception.",
    "designRules": [
      "DR-006",
      "DR-007"
    ]
  },
  {
    "id": "baseline-header-height",
    "type": "max-height",
    "selector": "body > header, [data-viewrule=page-header]",
    "max": 160,
    "optional": true,
    "severity": "warning",
    "reason": "Review headers taller than 160 CSS px so framing and controls leave space for the primary task.",
    "designRules": [
      "DR-008"
    ]
  },
  {
    "id": "guide-main-text",
    "type": "min-font-size",
    "selector": "main p, main li, main td, main th",
    "min": 14,
    "severity": "error",
    "reason": "Guide prose and reference tables remain readable; cell snapshots use smaller fixed geometry."
  },
  {
    "id": "guide-dark-color-scheme",
    "type": "style",
    "selector": "html",
    "property": "color-scheme",
    "allowed": [
      "dark"
    ],
    "severity": "error",
    "reason": "The guide stays in night mode regardless of system appearance."
  },
  {
    "id": "guide-night-background",
    "type": "style",
    "selector": "html, body",
    "property": "background-color",
    "allowed": [
      "rgb(16, 23, 34)"
    ],
    "severity": "error",
    "reason": "Page surfaces share the night background."
  },
  {
    "id": "guide-night-example-surfaces",
    "type": "style",
    "selector": "main pre:not(.terminal), main details",
    "property": "background-color",
    "allowed": [
      "rgb(27, 39, 52)"
    ],
    "optional": true,
    "severity": "error",
    "reason": "Code, saved output and disclosure panels share the night surface."
  },
  {
    "id": "guide-native-terminal-background",
    "type": "style",
    "selector": "main pre.terminal:not([data-theme]), main pre.terminal[data-theme=\"dark\"]",
    "property": "background-color",
    "allowed": [
      "rgb(16, 23, 34)"
    ],
    "severity": "error",
    "reason": "Native truecolor frames use the canonical theme background so dim tokens retain their contrast.",
    "optional": true
  },
  {
    "id": "guide-native-light-background",
    "type": "style",
    "selector": "main pre.terminal[data-theme=\"light\"]",
    "property": "background-color",
    "allowed": [
      "rgb(248, 250, 252)"
    ],
    "severity": "error",
    "optional": true,
    "reason": "Saved light frames retain their canonical native background independently of the guide chrome."
  },
  {
    "id": "guide-native-contrast-background",
    "type": "style",
    "selector": "main pre.terminal[data-theme=\"contrast\"]",
    "property": "background-color",
    "allowed": [
      "rgb(0, 0, 0)"
    ],
    "severity": "error",
    "optional": true,
    "reason": "Saved contrast frames retain their canonical native background independently of the guide chrome."
  },
  {
    "id": "guide-native-mono-background",
    "type": "style",
    "selector": "main pre.terminal[data-theme=\"mono\"]",
    "property": "background-color",
    "allowed": [
      "rgb(0, 0, 0)"
    ],
    "severity": "error",
    "optional": true,
    "reason": "Saved mono frames retain their canonical native background independently of the guide chrome."
  },
  {
    "id": "guide-native-light-foreground",
    "type": "style",
    "selector": "main pre.terminal[data-theme=\"light\"]",
    "property": "color",
    "allowed": [
      "rgb(23, 32, 51)"
    ],
    "severity": "error",
    "optional": true,
    "reason": "Unstyled runs after ANSI resets inherit the native light-theme foreground."
  }
]
